# Flask API
WEBTOON_HOST=127.0.0.1
WEBTOON_PORT=5000
WEBTOON_DEBUG=0
WEBTOON_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBTOON_MAX_UPLOAD_MB=25

# AI services
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60
GEMINI_PAGE_SPLITS=2
RTDETR_MODEL_ID=ogkalu/comic-text-and-bubble-detector
RTDETR_THRESHOLD=0.55
RTDETR_TEXT_LABELS=text_bubble,text_free
IOPAINT_MODEL=lama
AI_DEVICE=cpu
INPAINT_PADDING=8

# Optional local font. Keep private paths in your local .env, not in Git.
WEBTOON_TIGHT_SPOT_BB_PATH=
